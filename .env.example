APP_NAME=AI Career Path Creator
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/v1

DATABASE_URL=postgresql+asyncpg://user:password@your-server.postgres.database.azure.com:5432/career_path
DATABASE_ECHO=false

JWT_SECRET_KEY=replace-with-a-strong-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

AI_ENDPOINT=https://tophex.openai.azure.com/openai/v1
AI_API_KEY=
AI_DEPLOYMENT_NAME=gpt-5
AI_API_VERSION=2024-12-01-preview
AI_FOUNDRY_PROJECT_URL=https://tophex.services.ai.azure.com/api/projects/proj-tophex

AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY=1.0
AI_RETRY_MAX_DELAY=30.0
AI_REQUEST_TIMEOUT=60.0
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_HOUR=200
AI_RATE_LIMIT_PER_USER_PER_MINUTE=10
AI_RATE_LIMIT_PER_IP_PER_MINUTE=30
AI_RATE_LIMIT_PER_CONVERSATION_PER_MINUTE=15

AI_SUMMARY_THRESHOLD_MESSAGES=20
AI_SUMMARY_KEEP_RECENT=10
AI_MAX_CONTEXT_MESSAGES=50

RECOMMENDATION_SERVICE_URL=http://localhost:8001

CORS_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO
